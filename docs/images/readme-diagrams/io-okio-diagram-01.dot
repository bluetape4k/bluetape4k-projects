  daeadenc [label="DaeadChunkEncryptSink", fillcolor="#E8F3FF", color="#5B8DEF"];
  streamcmp [label="StreamingCompressSink", fillcolor="#EAF7EF", color="#58A978"];
  okb64k [label="OkioBase64Sink", fillcolor="#E9F7F6", color="#45A7A1"];
  apb64k [label="ApacheBase64Sink", fillcolor="#FFF3D9", color="#D6A441"];
  source -> input [color="#3E9868", fontcolor="#3E9868", style="solid", arrowhead="none", weight=10];
  source -> fsource [color="#4F83BF", fontcolor="#4F83BF", style="solid", arrowhead="none", weight=10];
