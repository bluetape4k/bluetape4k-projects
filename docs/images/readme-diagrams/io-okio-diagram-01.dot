  StreamingDecompressSource [label="StreamingDecompressSource", fillcolor="#FFF3D9", color="#D6A441"];
  { rank=source; AbstractBase64Sink; AbstractBase64Source; }
  Source -> Sink [color="#4F83BF", fontcolor="#4F83BF", style="solid", arrowhead="none", weight=10];
  Source -> ForwardingSink [color="#3E9868", fontcolor="#3E9868", style="dashed", arrowhead="none", weight=2];
