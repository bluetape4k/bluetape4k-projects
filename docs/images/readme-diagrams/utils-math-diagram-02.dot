digraph G {
  graph [rankdir=TB, splines=ortho, nodesep=0.95, ranksep=1.2, outputorder=edgesfirst, pack=false, sep="+0.9,0.9"];
  node [shape=box, style="rounded,filled", fontname="Comic Mono", fontsize=11, margin="0.16,0.10", width=2.8, height=1.05];
  edge [fontname="Comic Mono", fontsize=10, arrowsize=0.75, penwidth=1.8];
  Histogram [label="Histogram", fillcolor="#E8F3FF", color="#5B8DEF"];
  Interpolator [label="Interpolator", fillcolor="#EAF7EF", color="#58A978"];
  Descriptives [label="Descriptives", fillcolor="#E9F7F6", color="#45A7A1"];
  Integrator [label="Integrator", fillcolor="#FFF3D9", color="#D6A441"];
  WeightedDice [label="WeightedDice", fillcolor="#FDECEF", color="#DC6B82"];
  LinearInterpolator [label="LinearInterpolator", fillcolor="#F1ECFF", color="#8A72D6"];
  DoubleStatistics [label="DoubleStatistics", fillcolor="#EEF6D9", color="#8BA84D"];
  SplineInterpolator [label="SplineInterpolator", fillcolor="#F2F5F9", color="#9AA8B8"];
  { rank=source; Interpolator; Descriptives; Integrator; }
  Interpolator -> SplineInterpolator [color="#758297", fontcolor="#758297", style="solid", arrowhead="none", weight=10];
  Interpolator -> LinearInterpolator [color="#755BC6", fontcolor="#755BC6", style="solid", arrowhead="none", weight=10];
  Descriptives -> DoubleStatistics [color="#718A35", fontcolor="#718A35", style="solid", arrowhead="none", weight=10];
}
