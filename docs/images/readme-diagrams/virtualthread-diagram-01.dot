digraph G {
  graph [rankdir=TB, bgcolor="white", splines=ortho, nodesep=0.55, ranksep=0.75];
  node [shape=box, style="rounded,filled", fontname="Architects Daughter", fontsize=18, color="#D7E2EC", fillcolor="#F7FAFC"];
  edge [fontname="Comic Mono", fontsize=11, color="#56708C", arrowsize=0.8];
  "api" [label="Application calls VirtualThreads", shape=box, fillcolor="#E8F3FF", color="#75A9E8"];
  "loader" [label="Load VirtualThreadRuntime providers", shape=box, fillcolor="#EAF7EF", color="#69B888"];
  "jdk25-check" [label="JDK 25 provider usable?", shape=diamond, fillcolor="#F1ECFF", color="#8A72D6"];
  "jdk25" [label="JDK 25 runtime", shape=box, fillcolor="#F1ECFF", color="#8A72D6"];
  "jdk21-check" [label="JDK 21 provider usable?", shape=diamond, fillcolor="#E9F7F6", color="#45A7A1"];
  "jdk21" [label="JDK 21 runtime", shape=box, fillcolor="#E9F7F6", color="#45A7A1"];
  "fallback" [label="Platform thread fallback", shape=box, fillcolor="#FFF3D9", color="#D9AA4D"];
  "api" -> "loader" [color="#4F83BF"];
  "loader" -> "jdk25-check" [color="#58A978"];
  "jdk25-check" -> "jdk25" [color="#8A72D6"];
  "jdk25-check" -> "jdk21-check" [color="#6B7D90"];
  "jdk21-check" -> "jdk21" [color="#45A7A1"];
  "jdk21-check" -> "fallback" [color="#D9AA4D"];
}
