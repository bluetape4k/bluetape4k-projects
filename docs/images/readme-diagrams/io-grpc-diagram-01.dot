digraph G {
  graph [rankdir=TB, splines=ortho, nodesep=0.9, ranksep=1.1, outputorder=edgesfirst];
  node [shape=box, style="rounded,filled", fontname="Comic Mono", fontsize=11, margin="0.16,0.10"];
  edge [fontname="Comic Mono", fontsize=10, arrowsize=0.7, penwidth=1.8];
  GrpcServer [label="GrpcServer", fillcolor="#E8F3FF", color="#5B8DEF"];
  AbstractGrpcClient [label="AbstractGrpcClient", fillcolor="#EAF7EF", color="#58A978"];
  AbstractGrpcServer [label="AbstractGrpcServer", fillcolor="#E9F7F6", color="#45A7A1"];
  AbstractGrpcInprocessClient [label="AbstractGrpcInprocessClient", fillcolor="#F1ECFF", color="#8A72D6"];
  AbstractGrpcInprocessServer [label="AbstractGrpcInprocessServer", fillcolor="#FFF3D9", color="#D6A441"];
  ServerSupport [label="ServerSupport", fillcolor="#FDECEF", color="#DC6B82"];
  ManagedChannelSupport [label="ManagedChannelSupport", fillcolor="#EEF6D9", color="#8BA84D"];
  AbstractGrpcServer -> GrpcServer [style="solid", color="#4F83BF"];
  AbstractGrpcInprocessServer -> AbstractGrpcServer [style="solid", color="#2E8F89"];
  AbstractGrpcInprocessClient -> AbstractGrpcClient [style="solid", color="#3E9868"];
  AbstractGrpcInprocessServer -> AbstractGrpcInprocessClient [style="dashed", color="#755BC6"];
  AbstractGrpcServer -> ServerSupport [style="dashed", color="#C94D68"];
  AbstractGrpcClient -> ManagedChannelSupport [style="dashed", color="#718A35"];
}
