digraph G {
  graph [rankdir=LR, splines=ortho, nodesep=0.7, ranksep=0.85, fontname="Comic Mono", label="Snowflake Bit Layout"];
  node [shape=box, style="rounded,filled", fontname="Architects Daughter", fontsize=18, color="#D7E2EC", fillcolor="#F7FAFC"];
  edge [fontname="Comic Mono", fontsize=11, color="#56708C", arrowsize=0.8];
  "sign";
  "timestamp";
  "machineId";
  "sequence";
  "makeId";
  "parseSnowflakeId";
  "timestamp" -> "makeId" [label="shl 22"];
  "machineId" -> "makeId" [label="shl 12"];
  "sequence" -> "makeId" [label=""];
  "makeId" -> "parseSnowflakeId" [label="round-trip"];
}
