digraph G {
  graph [rankdir=TB, bgcolor="white", splines=ortho, nodesep=0.6, ranksep=0.85, fontname="Comic Mono", label="Hazelcast Two-Tier NearCache Runtime evidence", labelloc=t];
  node [shape=box, style="rounded,filled", fontname="Architects Daughter", fontsize=18, color="#D7E2EC", fillcolor="#F7FAFC"];
  edge [fontname="Comic Mono", fontsize=11, color="#56708C", arrowsize=0.8];
  "caller" [label="Application code", fillcolor="#E8F3FF", color="#75A9E8"];
  "facade" [label="HazelcastNearCache variants", fillcolor="#EAF7EF", color="#69B888"];
  "config" [label="HazelcastNearCacheConfig", fillcolor="#F1ECFF", color="#8A72D6"];
  "front" [label="Caffeine front cache", fillcolor="#E9F7F6", color="#45A7A1"];
  "imap" [label="Hazelcast IMap", fillcolor="#FFF3D9", color="#D9AA4D"];
  "listener" [label="IMap EntryListener", fillcolor="#FCE7F3", color="#DB7890"];
  "queue" [label="Write-behind queue", fillcolor="#EAF7EF", color="#69B888"];
  "strategy" [label="Failure strategy", fillcolor="#FDECEC", color="#DB7F75"];
  "caller" -> "facade" [label="cache API", color="#4F83BF", style="solid"];
  "config" -> "facade" [label="configures", color="#8A72D6", style="solid"];
  "facade" -> "front" [label="read first / fill", color="#45A7A1", style="solid"];
  "front" -> "imap" [label="miss lookup", color="#D9AA4D", style="solid"];
  "facade" -> "imap" [label="write-through", color="#58A978", style="solid"];
  "imap" -> "listener" [label="entry events", color="#DB7890", style="solid"];
  "listener" -> "front" [label="invalidate", color="#DB7890", style="solid"];
  "queue" -> "strategy" [label="retry / fallback", color="#C85D55", style="dashed"];
}
