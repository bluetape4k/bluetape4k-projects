digraph G {
  graph [rankdir=TB, splines=ortho, nodesep=0.95, ranksep=1.25, outputorder=edgesfirst];
  node [shape=box, style="rounded,filled", fontname="Comic Mono", fontsize=11, margin="0.16,0.10", width=2.7, height=1.0];
  edge [fontname="Comic Mono", fontsize=10, arrowsize=0.7, penwidth=1.8];
  jsonSerializer [label="JsonSerializer", fillcolor="#E8F3FF", color="#5B8DEF"];
  fastjsonSerializer [label="FastjsonSerializer", fillcolor="#EAF7EF", color="#58A978"];
  jsonb [label="JSONB", fillcolor="#FFF3D9", color="#D6A441"];
  json [label="JSON", fillcolor="#F1ECFF", color="#8A72D6"];
  jsonObjectExtensions [label="JSONObjectExtensions", fillcolor="#E9F7F6", color="#45A7A1"];
  jsonObject [label="JSONObject", fillcolor="#F2F5F9", color="#9AA8B8"];
  jsonReaderFeature [label="JSONReader.Feature", fillcolor="#FDECEF", color="#DC6B82"];
  { rank=same; jsonSerializer; jsonObject; }
  { rank=same; fastjsonSerializer; jsonObjectExtensions; jsonReaderFeature; }
  { rank=same; jsonb; json; }
  jsonSerializer -> fastjsonSerializer [color="#3E9868", fontcolor="#3E9868", style="solid", arrowhead="none", weight=12];
  fastjsonSerializer -> jsonb [color="#B9851B", fontcolor="#B9851B", style="dashed", arrowhead="none"];
  fastjsonSerializer -> json [color="#755BC6", fontcolor="#755BC6", style="dashed", arrowhead="none"];
  jsonObjectExtensions -> jsonObject [color="#2E8F89", fontcolor="#2E8F89", style="dashed", arrowhead="none"];
  jsonObjectExtensions -> jsonReaderFeature [color="#C94D68", fontcolor="#C94D68", style="dashed", arrowhead="none"];
}
