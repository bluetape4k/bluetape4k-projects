digraph G {
  graph [rankdir=TB, splines=ortho, nodesep=0.95, ranksep=1.2, outputorder=edgesfirst, pack=false, sep="+0.9,0.9"];
  node [shape=box, style="rounded,filled", fontname="Comic Mono", fontsize=11, margin="0.16,0.10", width=2.8, height=1.05];
  edge [fontname="Comic Mono", fontsize=10, arrowsize=0.75, penwidth=1.8];
  Sink [label="Sink", fillcolor="#E8F3FF", color="#5B8DEF"];
  Source [label="Source", fillcolor="#EAF7EF", color="#58A978"];
  ByteChannelSink [label="ByteChannelSink", fillcolor="#E9F7F6", color="#45A7A1"];
  ByteChannelSource [label="ByteChannelSource", fillcolor="#FFF3D9", color="#D6A441"];
  FileChannelSink [label="FileChannelSink", fillcolor="#FDECEF", color="#DC6B82"];
  FileChannelSource [label="FileChannelSource", fillcolor="#F1ECFF", color="#8A72D6"];
  Source -> Sink [color="#3E9868", fontcolor="#3E9868", style="solid", arrowhead="none", weight=10];
  Source -> ByteChannelSink [color="#B9851B", fontcolor="#B9851B", style="dashed", arrowhead="none", weight=2];
  ByteChannelSource -> ByteChannelSink [color="#2E8F89", fontcolor="#2E8F89", style="solid", arrowhead="none", weight=10];
  ByteChannelSource -> FileChannelSink [color="#755BC6", fontcolor="#755BC6", style="dashed", arrowhead="none", weight=2];
  FileChannelSource -> FileChannelSink [color="#C94D68", fontcolor="#C94D68", style="solid", arrowhead="none", weight=10];
}
