digraph G {
  graph [rankdir=TB, splines=ortho, nodesep=0.9, ranksep=1.1, outputorder=edgesfirst];
  node [shape=box, style="rounded,filled", fontname="Comic Mono", fontsize=11, margin="0.16,0.10"];
  edge [fontname="Comic Mono", fontsize=10, arrowsize=0.7, penwidth=1.8];
  batchCall [label="withBatch", fillcolor="#E8F3FF", color="#5B8DEF"];
  rBatch [label="RBatch", fillcolor="#EAF7EF", color="#58A978"];
  batchExecute [label="execute", fillcolor="#E9F7F6", color="#45A7A1"];
  batchResult [label="BatchResult", fillcolor="#FFF3D9", color="#D6A441"];
  txCall [label="withTransaction", fillcolor="#F1ECFF", color="#8A72D6"];
  rTx [label="RTransaction", fillcolor="#EAF7EF", color="#58A978"];
  txCommit [label="commit path", fillcolor="#E9F7F6", color="#45A7A1"];
  txRollback [label="rollback path", fillcolor="#FDECEF", color="#DC6B82"];
  txOutcome [label="Caller outcome", fillcolor="#FFF3D9", color="#D6A441"];
  batchCall -> rBatch [style="dashed", color="#4F83BF"];
  rBatch -> batchExecute [style="dashed", color="#3E9868"];
  batchExecute -> batchResult [style="dashed", color="#2E8F89"];
  txCall -> rTx [style="dashed", color="#755BC6"];
  rTx -> txCommit [style="dashed", color="#3E9868"];
  rTx -> txRollback [style="dashed", color="#C94D68"];
  txCommit -> txOutcome [style="dashed", color="#2E8F89"];
  txRollback -> txOutcome [style="dashed", color="#C94D68"];
}
