digraph G {
  graph [rankdir=TB, splines=ortho, nodesep=0.95, ranksep=1.25, outputorder=edgesfirst];
  node [shape=box, style="rounded,filled", fontname="Comic Mono", fontsize=11, margin="0.16,0.10", width=2.7, height=1.0];
  edge [fontname="Comic Mono", fontsize=10, arrowsize=0.7, penwidth=1.8];
  jsonSerializer [label="JsonSerializer", fillcolor="#E8F3FF", color="#5B8DEF"];
  jacksonSerializer [label="JacksonSerializer", fillcolor="#EAF7EF", color="#58A978"];
  jackson [label="Jackson", fillcolor="#F1ECFF", color="#8A72D6"];
  mapperSupport [label="JsonMapperSupport", fillcolor="#E9F7F6", color="#45A7A1"];
  objectMapper [label="ObjectMapper / JsonMapper", fillcolor="#F2F5F9", color="#9AA8B8"];
  textSerializers [label="CSV/YAML/TOML serializers", fillcolor="#FFF3D9", color="#D6A441"];
  binarySerializers [label="CBOR/Ion/Smile serializers", fillcolor="#FDECEF", color="#DC6B82"];
  uuidCryptoMask [label="UUID/Crypto/Mask modules", fillcolor="#F1ECFF", color="#8A72D6"];
  { rank=same; jsonSerializer; jackson; mapperSupport; }
  { rank=same; jacksonSerializer; objectMapper; }
  { rank=same; textSerializers; binarySerializers; uuidCryptoMask; }
  jsonSerializer -> jacksonSerializer [color="#3E9868", fontcolor="#3E9868", style="solid", arrowhead="none", weight=12];
  jacksonSerializer -> objectMapper [color="#758297", fontcolor="#758297", style="dashed", arrowhead="none"];
  jackson -> objectMapper [color="#755BC6", fontcolor="#755BC6", style="dashed", arrowhead="none"];
  mapperSupport -> objectMapper [color="#2E8F89", fontcolor="#2E8F89", style="dashed", arrowhead="none"];
  jacksonSerializer -> textSerializers [color="#B9851B", fontcolor="#B9851B", style="solid", arrowhead="none", weight=12];
  jacksonSerializer -> binarySerializers [color="#C94D68", fontcolor="#C94D68", style="solid", arrowhead="none", weight=12];
  uuidCryptoMask -> objectMapper [color="#755BC6", fontcolor="#755BC6", style="dashed", arrowhead="none"];
}
