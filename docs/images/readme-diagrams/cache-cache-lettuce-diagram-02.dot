digraph G {
  graph [rankdir=TB, bgcolor="white", splines=ortho, nodesep=0.6, ranksep=0.85, fontname="Comic Mono", label="Lettuce JCache NearCache Composition evidence", labelloc=t];
  node [shape=box, style="rounded,filled", fontname="Architects Daughter", fontsize=18, color="#D7E2EC", fillcolor="#F7FAFC"];
  edge [fontname="Comic Mono", fontsize=11, color="#56708C", arrowsize=0.8];
  "caller" [label="Application / JCache API", fillcolor="#E8F3FF", color="#75A9E8"];
  "factory" [label="LettuceCaches", fillcolor="#E8F3FF", color="#75A9E8"];
  "near" [label="NearJCache / SuspendNearJCache", fillcolor="#EAF7EF", color="#69B888"];
  "config" [label="NearJCacheConfig", fillcolor="#F1ECFF", color="#8A72D6"];
  "front" [label="Caffeine front JCache", fillcolor="#E9F7F6", color="#45A7A1"];
  "back" [label="LettuceJCache / LettuceSuspendJCache", fillcolor="#FFF3D9", color="#D9AA4D"];
  "listener" [label="CacheEntryListener", fillcolor="#FCE7F3", color="#DB7890"];
  "map" [label="LettuceMap", fillcolor="#F6F8FA", color="#AAB7C4"];
  "caller" -> "factory" [label="factory call", color="#4F83BF", style="solid"];
  "factory" -> "near" [label="creates", color="#4F83BF", style="solid"];
  "config" -> "near" [label="configures", color="#8A72D6", style="solid"];
  "near" -> "front" [label="read first", color="#45A7A1", style="solid"];
  "front" -> "back" [label="miss lookup / write", color="#D9AA4D", style="solid"];
  "near" -> "back" [label="back delegate", color="#58A978", style="solid"];
  "back" -> "listener" [label="entry events", color="#DB7890", style="solid"];
  "listener" -> "front" [label="updates front", color="#DB7890", style="solid"];
  "back" -> "map" [label="stores hash", color="#6B7D90", style="solid"];
}
