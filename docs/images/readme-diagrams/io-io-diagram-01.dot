digraph G {
  graph [rankdir=TB, splines=ortho, nodesep=0.9, ranksep=1.0, outputorder=edgesfirst];
  node [shape=box, style="rounded,filled", fontname="Comic Mono", fontsize=11, margin="0.16,0.10"];
  edge [fontname="Comic Mono", fontsize=10, arrowsize=0.7, penwidth=1.8];
  Compressor [fillcolor="#E8F3FF", color="#5B8DEF"];
  StreamingCompressor [fillcolor="#EAF7EF", color="#58A978"];
  AbstractCompressor [fillcolor="#E9F7F6", color="#45A7A1"];
  Compressors [fillcolor="#FFF3D9", color="#D6A441"];
  StreamingCompressors [fillcolor="#F1ECFF", color="#8A72D6"];
  LowLatency [label="Low-latency implementations", fillcolor="#EAF7EF", color="#58A978"];
  StandardFormats [label="Standard format implementations", fillcolor="#E8F3FF", color="#5B8DEF"];
  RatioOriented [label="Ratio-oriented implementations", fillcolor="#FDECEF", color="#DC6B82"];
  ZipBuilder [fillcolor="#FFF3D9", color="#D6A441"];
  ZipFileSupport [fillcolor="#E9F7F6", color="#45A7A1"];
  ZipBombGuards [label="ZIP bomb guards", fillcolor="#FDECEF", color="#DC6B82"];
  { rank=same; Compressor; StreamingCompressor; }
  { rank=same; AbstractCompressor; Compressors; StreamingCompressors; }
  { rank=same; LowLatency; StandardFormats; RatioOriented; }
  { rank=same; ZipBuilder; ZipFileSupport; ZipBombGuards; }
  AbstractCompressor -> Compressor [color="#2E8F89", arrowhead=empty, weight=10];
  LowLatency -> AbstractCompressor [color="#3E9868", arrowhead=empty, weight=8];
  StandardFormats -> AbstractCompressor [color="#4F83BF", arrowhead=empty, weight=8];
  RatioOriented -> AbstractCompressor [color="#C94D68", arrowhead=empty, weight=8];
  Compressors -> LowLatency [color="#B9851B", style=dashed];
  Compressors -> StandardFormats [color="#B9851B", style=dashed];
  Compressors -> RatioOriented [color="#B9851B", style=dashed];
  StreamingCompressors -> StreamingCompressor [color="#755BC6", style=dashed];
  StreamingCompressors -> Compressor [color="#755BC6", style=dashed];
  ZipBuilder -> ZipFileSupport [color="#2E8F89", style=dashed];
  ZipFileSupport -> ZipBombGuards [color="#C94D68", style=dashed];
}
