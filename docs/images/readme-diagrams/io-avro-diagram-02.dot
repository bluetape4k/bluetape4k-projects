digraph G {
  graph [rankdir=TB, bgcolor="white", splines=ortho, nodesep=0.55, ranksep=0.75];
  node [shape=box, style="rounded,filled", fontname="Architects Daughter", fontsize=18, color="#D7E2EC", fillcolor="#F7FAFC"];
  edge [fontname="Comic Mono", fontsize=11, color="#56708C", arrowsize=0.8];
  "start" [label="Start with payload workload", shape=box, fillcolor="#E8F3FF", color="#75A9E8"];
  "compression" [label="Need compression?", shape=diamond, fillcolor="#F1ECFF", color="#8A72D6"];
  "throughput" [label="Fast local transfer?", shape=diamond, fillcolor="#E9F7F6", color="#45A7A1"];
  "snappy" [label="SNAPPY_CODEC_FACTORY", shape=box, fillcolor="#E9F7F6", color="#45A7A1"];
  "deflate" [label="DEFAULT_CODEC_FACTORY", shape=box, fillcolor="#EAF7EF", color="#69B888"];
  "archive" [label="Small archive?", shape=diamond, fillcolor="#FFF3D9", color="#D9AA4D"];
  "zstd" [label="ARCHIVE_CODEC_FACTORY", shape=box, fillcolor="#FFF3D9", color="#D9AA4D"];
  "null" [label="NULL_CODEC_FACTORY", shape=box, fillcolor="#F6F8FA", color="#AAB7C4"];
  "output" [label="ByteArray output", shape=box, fillcolor="#FCE7F3", color="#DB7890"];
  "start" -> "compression" [color="#4F83BF"];
  "compression" -> "throughput" [color="#45A7A1"];
  "compression" -> "deflate" [color="#58A978"];
  "compression" -> "archive" [color="#D9AA4D"];
  "throughput" -> "snappy" [color="#45A7A1"];
  "archive" -> "zstd" [color="#D9AA4D"];
  "deflate" -> "output" [color="#58A978"];
  "snappy" -> "output" [color="#45A7A1"];
  "zstd" -> "output" [color="#D9AA4D"];
  "null" -> "output" [color="#6B7D90"];
}
