digraph G {
  graph [rankdir=LR, splines=ortho, nodesep=0.7, ranksep=0.9, outputorder=edgesfirst];
  node [shape=box, style="rounded,filled", fontname="Architects Daughter", fontsize=18, margin="0.18,0.10"];
  edge [fontname="Architects Daughter", fontsize=12, color="#758297", arrowsize=0.8];
  app [label="Application", fillcolor="#E8F3FF", color="#5B8DEF"];
  cid [label="CallId", fillcolor="#E9F7F6", color="#45A7A1"];
  logging [label="CallLogging", fillcolor="#EAF7EF", color="#58A978"];
  metrics [label="MicrometerMetrics", fillcolor="#FFF3D9", color="#D6A441"];
  prom [label="Prometheus route", fillcolor="#FDECEF", color="#DC6B82"];
  ops [label="Operators", fillcolor="#F1ECFF", color="#8A72D6"];
  app -> cid [label="installs"];
  app -> logging [label="installs"];
  app -> metrics [label="supplies"];
  metrics -> prom [label="registry"];
  cid -> logging [label="MDC"];
  logging -> ops [label="logs"];
  prom -> ops [label="scrape"];
}
