digraph G {
  graph [rankdir=TB, splines=ortho, nodesep=0.9, ranksep=1.1, outputorder=edgesfirst];
  node [shape=box, style="rounded,filled", fontname="Comic Mono", fontsize=11, margin="0.16,0.10"];
  edge [fontname="Comic Mono", fontsize=10, arrowsize=0.7, penwidth=1.8];
  suspendFlow [label="Suspend or Flow work", fillcolor="#E8F3FF", color="#5B8DEF"];
  clientWork [label="HTTP or cache work", fillcolor="#FFF3D9", color="#D6A441"];
  eventWork [label="Event publish/consume", fillcolor="#EAF7EF", color="#58A978"];
  timerHelper [label="Timer extensions", fillcolor="#E8F3FF", color="#5B8DEF"];
  binderHelper [label="Instrumentation binders", fillcolor="#FFF3D9", color="#D6A441"];
  observationHelper [label="Observation helpers", fillcolor="#EAF7EF", color="#58A978"];
  meterRegistry [label="MeterRegistry", fillcolor="#E8F3FF", color="#5B8DEF"];
  observationRegistry [label="ObservationRegistry", fillcolor="#EAF7EF", color="#58A978"];
  timerSignal [label="Timer metrics", fillcolor="#E8F3FF", color="#5B8DEF"];
  eventSignal [label="Observation signal", fillcolor="#EAF7EF", color="#58A978"];
  suspendFlow -> timerHelper [style="dashed", color="#4F83BF"];
  clientWork -> binderHelper [style="dashed", color="#B9851B"];
  eventWork -> observationHelper [style="dashed", color="#3E9868"];
  timerHelper -> meterRegistry [style="dashed", color="#4F83BF"];
  binderHelper -> meterRegistry [style="dashed", color="#B9851B"];
  observationHelper -> observationRegistry [style="dashed", color="#3E9868"];
  meterRegistry -> timerSignal [style="dashed", color="#4F83BF"];
  observationRegistry -> eventSignal [style="dashed", color="#3E9868"];
}
