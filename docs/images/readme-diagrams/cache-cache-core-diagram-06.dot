digraph G {
  graph [rankdir=TB, bgcolor="white", splines=ortho, nodesep=0.6, ranksep=0.85, fontname="Comic Mono", label="SuspendNearJCache Coroutine Two-Tier Cache evidence", labelloc=t];
  node [shape=box, style="rounded,filled", fontname="Architects Daughter", fontsize=18, color="#D7E2EC", fillcolor="#F7FAFC"];
  edge [fontname="Comic Mono", fontsize=11, color="#56708C", arrowsize=0.8];
  "caller" [label="Coroutine service code", fillcolor="#E8F3FF", color="#75A9E8"];
  "near" [label="SuspendNearJCache<K,V>", fillcolor="#EAF7EF", color="#69B888"];
  "entries" [label="entries() / getAll()", fillcolor="#E9F7F6", color="#45A7A1"];
  "front" [label="Front SuspendJCache", fillcolor="#E9F7F6", color="#45A7A1"];
  "back" [label="Back SuspendJCache", fillcolor="#FFF3D9", color="#D9AA4D"];
  "listener" [label="SuspendJCacheEntryEventListener", fillcolor="#FCE7F3", color="#DB7890"];
  "without" [label="withoutListener(...)", fillcolor="#F1ECFF", color="#8A72D6"];
  "factory" [label="Factory registration", fillcolor="#F6F8FA", color="#AAB7C4"];
  "caller" -> "near" [label="suspend API", color="#4F83BF", style="solid"];
  "near" -> "entries" [label="Flow entries", color="#45A7A1", style="solid"];
  "near" -> "front" [label="front fast path", color="#45A7A1", style="solid"];
  "front" -> "back" [label="miss lookup / fill", color="#D9AA4D", style="solid"];
  "near" -> "back" [label="write-through", color="#58A978", style="solid"];
  "factory" -> "back" [label="registers listener", color="#6B7D90", style="solid"];
  "back" -> "listener" [label="entry events", color="#DB7890", style="solid"];
  "listener" -> "front" [label="updates front", color="#DB7890", style="solid"];
  "without" -> "back" [label="listener-free option", color="#8A72D6", style="dashed"];
}
