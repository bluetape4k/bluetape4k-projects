digraph G {
  graph [rankdir=TB, splines=ortho, nodesep=0.95, ranksep=1.2, outputorder=edgesfirst, pack=false, sep="+0.9,0.9"];
  node [shape=box, style="rounded,filled", fontname="Comic Mono", fontsize=11, margin="0.16,0.10", width=2.8, height=1.05];
  edge [fontname="Comic Mono", fontsize=10, arrowsize=0.75, penwidth=1.8];
  SuspendedPipe [label="SuspendedPipe", fillcolor="#E8F3FF", color="#5B8DEF"];
  SuspendedSink [label="SuspendedSink", fillcolor="#EAF7EF", color="#58A978"];
  SuspendedSource [label="SuspendedSource", fillcolor="#E9F7F6", color="#45A7A1"];
  BufferedSuspendedSink [label="BufferedSuspendedSink", fillcolor="#FFF3D9", color="#D6A441"];
  BufferedSuspendedSource [label="BufferedSuspendedSource", fillcolor="#FDECEF", color="#DC6B82"];
  SuspendedFileChannelSink [label="SuspendedFileChannelSink", fillcolor="#F1ECFF", color="#8A72D6"];
  SuspendedFileChannelSource [label="SuspendedFileChannelSource", fillcolor="#EEF6D9", color="#8BA84D"];
  SuspendedSocketChannelSink [label="SuspendedSocketChannelSink", fillcolor="#F2F5F9", color="#9AA8B8"];
  SuspendedSocketChannelSource [label="SuspendedSocketChannelSource", fillcolor="#E8F3FF", color="#5B8DEF"];
  RealBufferedSuspendedSink [label="RealBufferedSuspendedSink", fillcolor="#EAF7EF", color="#58A978"];
  RealBufferedSuspendedSource [label="RealBufferedSuspendedSource", fillcolor="#E9F7F6", color="#45A7A1"];
  SuspendedSink -> SuspendedPipe [color="#3E9868", fontcolor="#3E9868", style="solid", arrowhead="none", weight=10];
  SuspendedSink -> SuspendedSource [color="#B9851B", fontcolor="#B9851B", style="dashed", arrowhead="none", weight=2];
  BufferedSuspendedSink -> SuspendedSource [color="#2E8F89", fontcolor="#2E8F89", style="solid", arrowhead="none", weight=10];
  BufferedSuspendedSink -> BufferedSuspendedSource [color="#755BC6", fontcolor="#755BC6", style="dashed", arrowhead="none", weight=2];
  SuspendedFileChannelSink -> BufferedSuspendedSource [color="#C94D68", fontcolor="#C94D68", style="solid", arrowhead="none", weight=10];
  SuspendedFileChannelSink -> SuspendedFileChannelSource [color="#4F63C7", fontcolor="#4F63C7", style="dashed", arrowhead="none", weight=2];
  SuspendedSocketChannelSink -> SuspendedFileChannelSource [color="#718A35", fontcolor="#718A35", style="solid", arrowhead="none", weight=10];
  SuspendedSocketChannelSink -> SuspendedSocketChannelSource [color="#8E6D43", fontcolor="#8E6D43", style="dashed", arrowhead="none", weight=2];
  RealBufferedSuspendedSink -> SuspendedSocketChannelSource [color="#C8644B", fontcolor="#C8644B", style="solid", arrowhead="none", weight=10];
  RealBufferedSuspendedSink -> RealBufferedSuspendedSource [color="#A84B98", fontcolor="#A84B98", style="dashed", arrowhead="none", weight=2];
}
