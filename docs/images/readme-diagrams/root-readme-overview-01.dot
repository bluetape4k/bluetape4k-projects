digraph G {
  graph [rankdir=LR, splines=ortho, nodesep=0.7, ranksep=0.9, outputorder=edgesfirst];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=18, margin="0.18,0.10"];
  edge [fontname="Arial", fontsize=12, color="#758297", arrowsize=0.8];
  bom [label="BOM", fillcolor="#EAF7EF", color="#58A978"];
  foundation [label="Foundation", fillcolor="#E8F3FF", color="#5B8DEF"];
  runtime [label="Runtime adapters", fillcolor="#FFF3D9", color="#D6A441"];
  apps [label="Applications", fillcolor="#E9F7F6", color="#45A7A1"];
  external [label="Split repositories", fillcolor="#F1ECFF", color="#8A72D6"];
  platform [label="Developer platform", fillcolor="#FDECEF", color="#DC6B82"];
  users [label="Backend services", fillcolor="#EEF6D9", color="#8BA84D"];
  bom -> foundation [label="aligns"];
  foundation -> runtime [label="extends"];
  runtime -> apps [label="powers"];
  external -> platform [label="coordinates"];
  platform -> users [label="targets"];
  runtime -> users [label="used by"];
}
