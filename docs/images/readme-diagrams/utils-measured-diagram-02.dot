digraph G {
  graph [rankdir=LR, splines=ortho, nodesep=0.7, ranksep=0.85, fontname="Comic Mono", label="Unit Composition Flow"];
  node [shape=box, style="rounded,filled", fontname="Architects Daughter", fontsize=18, color="#D7E2EC", fillcolor="#F7FAFC"];
  edge [fontname="Comic Mono", fontsize=11, color="#56708C", arrowsize=0.8];
  "Number";
  "Units";
  "Measure";
  "UnitsProduct";
  "UnitsRatio";
  "InverseUnits";
  "Area";
  "Velocity";
  "Acceleration";
  "Number" -> "Units" [label="*"];
  "Units" -> "Measure" [label="wrap"];
  "Units" -> "UnitsProduct" [label="*"];
  "Units" -> "UnitsRatio" [label="/"];
  "Units" -> "InverseUnits" [label="reciprocal"];
  "UnitsProduct" -> "Area" [label="Length*Length"];
  "UnitsRatio" -> "Velocity" [label="Length/Time"];
  "UnitsRatio" -> "Acceleration" [label="Length/Time^2"];
}
