digraph G {
  graph [rankdir=TB, bgcolor="white", splines=ortho, nodesep=0.55, ranksep=0.75];
  node [shape=box, style="rounded,filled", fontname="Architects Daughter", fontsize=18, color="#D7E2EC", fillcolor="#F7FAFC"];
  edge [fontname="Comic Mono", fontsize=11, color="#56708C", arrowsize=0.8];
  subgraph cluster_0 {
    label="Module entrypoint";
    color="#D7E2EC";
    style="rounded,filled";
    fillcolor="#F3F7FB";
    rank=same;
    "science" [label="bluetape4k-science", fillcolor="#E8F3FF", color="#75A9E8"];
  }
  subgraph cluster_1 {
    label="Coordinate model";
    color="#D7E2EC";
    style="rounded,filled";
    fillcolor="#F3F7FB";
    rank=same;
    "coords" [label="Coordinate types", fillcolor="#EAF7EF", color="#69B888"];
    "utm" [label="UTM helpers", fillcolor="#E9F7F6", color="#45A7A1"];
  }
  subgraph cluster_2 {
    label="Projection";
    color="#D7E2EC";
    style="rounded,filled";
    fillcolor="#F3F7FB";
    rank=same;
    "projection" [label="Projection registry", fillcolor="#F1ECFF", color="#8A72D6"];
    "geometry" [label="Geometry operations", fillcolor="#FCE7F3", color="#DB7890"];
  }
  subgraph cluster_3 {
    label="File and data model";
    color="#D7E2EC";
    style="rounded,filled";
    fillcolor="#F3F7FB";
    rank=same;
    "shapefile" [label="Shapefile reader", fillcolor="#FFF3D9", color="#D9AA4D"];
    "netcdf-model" [label="NetCDF models", fillcolor="#EEF6D9", color="#8BA84D"];
    "spatial-model" [label="Spatial models", fillcolor="#EAF7EF", color="#69B888"];
  }
  subgraph cluster_4 {
    label="Persistence";
    color="#D7E2EC";
    style="rounded,filled";
    fillcolor="#F3F7FB";
    rank=same;
    "tables" [label="Exposed tables", fillcolor="#E9F7F6", color="#45A7A1"];
    "repos" [label="Repositories", fillcolor="#F1ECFF", color="#8A72D6"];
    "services" [label="Import services", fillcolor="#FFF3D9", color="#D9AA4D"];
  }
  "science" -> "coords" [xlabel="models", color="#58A978"];
  "science" -> "utm" [xlabel="zone helpers", color="#45A7A1"];
  "coords" -> "projection" [xlabel="CRS conversion", color="#8A72D6"];
  "coords" -> "geometry" [xlabel="geometry input", color="#DB7890"];
  "projection" -> "shapefile" [xlabel="reproject", color="#D9AA4D"];
  "geometry" -> "spatial-model" [xlabel="features", color="#58A978"];
  "projection" -> "netcdf-model" [xlabel="grid CRS", color="#8BA84D"];
  "shapefile" -> "tables" [xlabel="shape import", color="#45A7A1"];
  "netcdf-model" -> "tables" [xlabel="grid import", color="#45A7A1"];
  "spatial-model" -> "repos" [xlabel="record mapping", color="#8A72D6"];
  "tables" -> "repos" [xlabel="SQL access", color="#8A72D6"];
  "repos" -> "services" [xlabel="orchestrate", color="#D9AA4D"];
}
