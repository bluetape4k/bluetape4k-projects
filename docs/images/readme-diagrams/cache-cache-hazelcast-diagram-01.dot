digraph G {
  graph [rankdir=TB, bgcolor="white", splines=ortho, nodesep=0.6, ranksep=0.85, fontname="Comic Mono", label="Hazelcast NearCache Class Structure evidence", labelloc=t];
  node [shape=box, style="rounded,filled", fontname="Architects Daughter", fontsize=18, color="#D7E2EC", fillcolor="#F7FAFC"];
  edge [fontname="Comic Mono", fontsize=11, color="#56708C", arrowsize=0.8];
  "ops" [label="NearCacheOperations<V>", fillcolor="#E8F3FF", color="#75A9E8"];
  "suspendOps" [label="SuspendNearCacheOperations<V>", fillcolor="#E9F7F6", color="#45A7A1"];
  "near" [label="HazelcastNearCache<V>", fillcolor="#EAF7EF", color="#69B888"];
  "suspendNear" [label="HazelcastSuspendNearCache<V>", fillcolor="#EAF7EF", color="#69B888"];
  "local" [label="HazelcastLocalCache<K,V>", fillcolor="#E9F7F6", color="#45A7A1"];
  "caffeine" [label="CaffeineHazelcastLocalCache<V>", fillcolor="#FFF3D9", color="#D9AA4D"];
  "imap" [label="Hazelcast IMap", fillcolor="#F1ECFF", color="#8A72D6"];
  "listener" [label="HazelcastEntryEventListener", fillcolor="#FCE7F3", color="#DB7890"];
  "factory" [label="HazelcastCaches", fillcolor="#E8F3FF", color="#75A9E8"];
  "jcache" [label="JCache factory note", fillcolor="#F6F8FA", color="#AAB7C4"];
  "near" -> "ops" [label="implements", color="#58A978", style="solid"];
  "suspendNear" -> "suspendOps" [label="implements", color="#58A978", style="solid"];
  "caffeine" -> "local" [label="implements", color="#D9AA4D", style="solid"];
  "imap" -> "listener" [label="entry events", color="#DB7890", style="solid"];
  "listener" -> "caffeine" [label="invalidates", color="#DB7890", style="solid"];
  "factory" -> "jcache" [label="documents", color="#6B7D90", style="dashed"];
}
