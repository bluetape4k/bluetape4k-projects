digraph G {
  graph [rankdir=TB, bgcolor="white", splines=ortho, nodesep=0.55, ranksep=0.75];
  node [shape=box, style="rounded,filled", fontname="Architects Daughter", fontsize=18, color="#D7E2EC", fillcolor="#F7FAFC"];
  edge [fontname="Comic Mono", fontsize=11, color="#56708C", arrowsize=0.8];
  "app" [label="Application instrumentation", shape=box, fillcolor="#E8F3FF", color="#75A9E8"];
  "support" [label="Bluetape4k OTel support", shape=box, fillcolor="#EAF7EF", color="#69B888"];
  "tracer" [label="SdkTracerProvider", shape=box, fillcolor="#F1ECFF", color="#8A72D6"];
  "meter" [label="SdkMeterProvider", shape=box, fillcolor="#E9F7F6", color="#45A7A1"];
  "span-processor" [label="SpanProcessor", shape=box, fillcolor="#FCE7F3", color="#DB7890"];
  "metric-reader" [label="MetricReader", shape=box, fillcolor="#FFF3D9", color="#D9AA4D"];
  "exporters" [label="Exporter set", shape=box, fillcolor="#EAF7EF", color="#69B888"];
  "collector" [label="OTel Collector", shape=box, fillcolor="#E9F7F6", color="#45A7A1"];
  "test-backend" [label="Test backend", shape=box, fillcolor="#F6F8FA", color="#AAB7C4"];
  "app" -> "support" [color="#4F83BF"];
  "support" -> "tracer" [color="#8A72D6"];
  "support" -> "meter" [color="#45A7A1"];
  "tracer" -> "span-processor" [color="#DB7890"];
  "meter" -> "metric-reader" [color="#D9AA4D"];
  "span-processor" -> "exporters" [color="#DB7890"];
  "metric-reader" -> "exporters" [color="#D9AA4D"];
  "exporters" -> "collector" [color="#45A7A1"];
  "exporters" -> "test-backend" [color="#6B7D90"];
}
