digraph G {
  graph [rankdir=TB, bgcolor="white", splines=ortho, nodesep=0.6, ranksep=0.85, fontname="Comic Mono", label="NearJCache Two-Tier Write-Through evidence", labelloc=t];
  node [shape=box, style="rounded,filled", fontname="Architects Daughter", fontsize=18, color="#D7E2EC", fillcolor="#F7FAFC"];
  edge [fontname="Comic Mono", fontsize=11, color="#56708C", arrowsize=0.8];
  "caller" [label="Application / JCache client", fillcolor="#E8F3FF", color="#75A9E8"];
  "near" [label="NearJCache<K,V>", fillcolor="#EAF7EF", color="#69B888"];
  "config" [label="NearJCacheConfig DSL", fillcolor="#F1ECFF", color="#8A72D6"];
  "front" [label="Front JCache", fillcolor="#E9F7F6", color="#45A7A1"];
  "back" [label="Back JCache", fillcolor="#FFF3D9", color="#D9AA4D"];
  "listener" [label="JCacheEntryEventListener", fillcolor="#FCE7F3", color="#DB7890"];
  "sync" [label="syncBackCache", fillcolor="#F6F8FA", color="#AAB7C4"];
  "caller" -> "near" [label="JCache calls", color="#4F83BF", style="solid"];
  "near" -> "front" [label="read first / fill", color="#45A7A1", style="solid"];
  "front" -> "back" [label="front miss lookup", color="#D9AA4D", style="solid"];
  "sync" -> "back" [label="write-through", color="#6B7D90", style="solid"];
  "near" -> "sync" [label="mutations", color="#58A978", style="solid"];
  "back" -> "listener" [label="entry events", color="#DB7890", style="solid"];
  "listener" -> "front" [label="invalidate/update", color="#DB7890", style="solid"];
  "config" -> "near" [label="configures", color="#8A72D6", style="solid"];
}
