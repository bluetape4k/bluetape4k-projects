digraph G {
  graph [rankdir=TB, bgcolor="white", splines=ortho, nodesep=0.6, ranksep=0.85, fontname="Comic Mono", label="Lettuce RESP3 NearCache Runtime evidence", labelloc=t];
  node [shape=box, style="rounded,filled", fontname="Architects Daughter", fontsize=18, color="#D7E2EC", fillcolor="#F7FAFC"];
  edge [fontname="Comic Mono", fontsize=11, color="#56708C", arrowsize=0.8];
  "caller" [label="Application code", fillcolor="#E8F3FF", color="#75A9E8"];
  "facade" [label="LettuceNearCache variants", fillcolor="#EAF7EF", color="#69B888"];
  "keys" [label="Key isolation", fillcolor="#F1ECFF", color="#8A72D6"];
  "front" [label="LettuceCaffeineLocalCache", fillcolor="#E9F7F6", color="#45A7A1"];
  "redis" [label="Redis backend", fillcolor="#FFF3D9", color="#D9AA4D"];
  "tracking" [label="TrackingInvalidationListener", fillcolor="#FCE7F3", color="#DB7890"];
  "queue" [label="Resilient write lane", fillcolor="#EAF7EF", color="#69B888"];
  "push" [label="Redis push message", fillcolor="#FDECEC", color="#DB7F75"];
  "caller" -> "facade" [label="cache API", color="#4F83BF", style="solid"];
  "keys" -> "facade" [label="configures", color="#8A72D6", style="solid"];
  "facade" -> "front" [label="read first", color="#45A7A1", style="solid"];
  "front" -> "redis" [label="miss lookup", color="#D9AA4D", style="solid"];
  "facade" -> "redis" [label="write-through", color="#58A978", style="solid"];
  "redis" -> "tracking" [label="push event", color="#DB7890", style="solid"];
  "tracking" -> "front" [label="invalidate", color="#DB7890", style="solid"];
  "redis" -> "push" [label="invalidates", color="#C85D55", style="dashed"];
}
