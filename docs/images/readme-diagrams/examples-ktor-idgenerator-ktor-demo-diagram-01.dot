digraph G {
  graph [rankdir=LR, splines=ortho, nodesep=0.7, ranksep=0.9, outputorder=edgesfirst];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=18, margin="0.18,0.10"];
  edge [fontname="Arial", fontsize=12, color="#758297", arrowsize=0.8];
  client [label="HTTP client", fillcolor="#E8F3FF", color="#5B8DEF"];
  ktor [label="Ktor application", fillcolor="#EAF7EF", color="#58A978"];
  routes [label="Routes", fillcolor="#E9F7F6", color="#45A7A1"];
  registry [label="IdGeneratorRegistry", fillcolor="#FFF3D9", color="#D6A441"];
  ids [label="ID generators", fillcolor="#FDECEF", color="#DC6B82"];
  client -> ktor [label="request"];
  ktor -> routes [label="routing"];
  routes -> registry [label="nextId/nextIds"];
  registry -> ids [label="delegates"];
  registry -> client [label="JSON response"];
  ktor -> client [label="errors + correlation ID"];
}
