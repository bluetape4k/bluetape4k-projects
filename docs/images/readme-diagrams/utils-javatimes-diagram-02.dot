  MonthRange [label="MonthRange", fillcolor="#F2F5F9", color="#9AA8B8"];
  HourRange [label="HourRange", fillcolor="#E8F3FF", color="#5B8DEF"];
  DayRange [label="DayRange", fillcolor="#EAF7EF", color="#58A978"];
  MinuteRange [label="MinuteRange", fillcolor="#E9F7F6", color="#45A7A1"];
  WeekRange [label="WeekRange", fillcolor="#FFF3D9", color="#D6A441"];
  YearRange [label="YearRange", fillcolor="#FDECEF", color="#DC6B82"];
  DateAdd -> TimeRange [color="#2E8F89", fontcolor="#2E8F89", style="dashed", arrowhead="none", weight=2];
  CalendarTimeRange -> MinuteRange [color="#4F83BF", fontcolor="#4F83BF", style="solid", arrowhead="none", weight=10];
  CalendarTimeRange -> HourRange [color="#2E8F89", fontcolor="#2E8F89", style="solid", arrowhead="none", weight=10];
