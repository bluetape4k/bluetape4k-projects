  CalendarTimeRange -> YearRange [color="#718A35", fontcolor="#718A35", style="solid", arrowhead="none", weight=10];
  TimeRange -> CalendarTimeRange [color="#4F63C7", fontcolor="#4F63C7", style="solid", arrowhead="none", weight=10];
  TimePeriod -> TimeRange [color="#C8644B", fontcolor="#C8644B", style="solid", arrowhead="none", weight=10];
  TimePeriod -> TimeBlock [color="#8E6D43", fontcolor="#8E6D43", style="solid", arrowhead="none", weight=10];
