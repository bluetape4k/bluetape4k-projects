digraph G {
  graph [rankdir=TB, splines=ortho, nodesep=0.9, ranksep=1.1, outputorder=edgesfirst];
  node [shape=box, style="rounded,filled", fontname="Comic Mono", fontsize=11, margin="0.16,0.10"];
  edge [fontname="Comic Mono", fontsize=10, arrowsize=0.7, penwidth=1.8];
  RedissonCodecs [label="RedissonCodecs", fillcolor="#E8F3FF", color="#5B8DEF"];
  ForyCodec [label="ForyCodec", fillcolor="#EAF7EF", color="#58A978"];
  FastForyCodec [label="FastForyCodec", fillcolor="#E9F7F6", color="#45A7A1"];
  JsonCodecs [label="JSON codecs", fillcolor="#FFF3D9", color="#D6A441"];
  BuiltinCodecs [label="Built-in codecs", fillcolor="#F2F5F9", color="#9AA8B8"];
  CompressionWrappers [label="Compression wrappers", fillcolor="#FDECEF", color="#DC6B82"];
  CompositeCodecs [label="Composite codecs", fillcolor="#F1ECFF", color="#8A72D6"];
  RedissonCodecs -> ForyCodec [style="dashed", color="#3E9868"];
  RedissonCodecs -> FastForyCodec [style="dashed", color="#2E8F89"];
  RedissonCodecs -> JsonCodecs [style="dashed", color="#B9851B"];
  RedissonCodecs -> BuiltinCodecs [style="dashed", color="#758297"];
  ForyCodec -> CompressionWrappers [style="dashed", color="#C94D68"];
  FastForyCodec -> CompressionWrappers [style="dashed", color="#C94D68"];
  JsonCodecs -> CompositeCodecs [style="dashed", color="#755BC6"];
  BuiltinCodecs -> CompositeCodecs [style="dashed", color="#755BC6"];
}
