  KafkaAppender -> KafkaExporter [color="#755BC6", fontcolor="#755BC6", style="dashed", arrowhead="none", weight=2];
  KafkaKeyProvider -> NullKafkaKeyProvider [color="#4F83BF", fontcolor="#4F83BF", style="solid", arrowhead="none", weight=10];
