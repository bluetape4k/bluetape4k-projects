  KafkaKeyProvider -> HostnameKafkaKeyProvider [color="#B9851B", fontcolor="#B9851B", style="solid", arrowhead="none", weight=10];
  KafkaExporter -> DefaultKafkaExporter [color="#718A35", fontcolor="#718A35", style="solid", arrowhead="none", weight=10];
  AbstractKafkaAppender -> KafkaAppender [color="#755BC6", fontcolor="#755BC6", style="solid", arrowhead="none", weight=10];
