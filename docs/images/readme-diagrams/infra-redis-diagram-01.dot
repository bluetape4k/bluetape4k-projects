digraph G {
  graph [rankdir=TB, splines=ortho, nodesep=0.9, ranksep=1.1, outputorder=edgesfirst];
  node [shape=box, style="rounded,filled", fontname="Comic Mono", fontsize=11, margin="0.16,0.10"];
  edge [fontname="Comic Mono", fontsize=10, arrowsize=0.7, penwidth=1.8];
  umbrella [label="bluetape4k-redis umbrella", fillcolor="#E8F3FF", color="#5B8DEF"];
  lettuce [label="bluetape4k-lettuce", fillcolor="#EAF7EF", color="#58A978"];
  redisson [label="bluetape4k-redisson", fillcolor="#F1ECFF", color="#8A72D6"];
  springRedis [label="spring-data-redis", fillcolor="#FFF3D9", color="#D6A441"];
  umbrella -> lettuce [style="dashed", color="#3E9868"];
  umbrella -> redisson [style="dashed", color="#755BC6"];
  springRedis -> redisGuidance [style="dashed", color="#B9851B"];
  lettuce -> redisGuidance [style="dashed", color="#3E9868"];
  redisson -> redisGuidance [style="dashed", color="#755BC6"];
}
