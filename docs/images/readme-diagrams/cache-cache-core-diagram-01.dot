digraph G {
  graph [rankdir=TB, bgcolor="white", splines=ortho, nodesep=0.6, ranksep=0.85, fontname="Comic Mono", label="NearCache Interface Hierarchy evidence", labelloc=t];
  node [shape=box, style="rounded,filled", fontname="Architects Daughter", fontsize=18, color="#D7E2EC", fillcolor="#F7FAFC"];
  edge [fontname="Comic Mono", fontsize=11, color="#56708C", arrowsize=0.8];
  "ops" [label="NearCacheOperations<V>", fillcolor="#E8F3FF", color="#75A9E8"];
  "suspendOps" [label="SuspendNearCacheOperations<V>", fillcolor="#E9F7F6", color="#45A7A1"];
  "decorator" [label="ResilientNearCacheDecorator<V>", fillcolor="#EAF7EF", color="#69B888"];
  "suspendDecorator" [label="ResilientSuspendNearCacheDecorator<V>", fillcolor="#EAF7EF", color="#69B888"];
  "nativeBackends" [label="Native NearCache modules", fillcolor="#FFF3D9", color="#D9AA4D"];
  "jcacheBackends" [label="JCache-backed modules", fillcolor="#F1ECFF", color="#8A72D6"];
  "stats" [label="NearCacheStatistics", fillcolor="#FCE7F3", color="#DB7890"];
  "resilienceConfig" [label="NearCacheResilienceConfig", fillcolor="#FFF3D9", color="#D9AA4D"];
  "failure" [label="GetFailureStrategy", fillcolor="#FDECEC", color="#DB7F75"];
  "decorator" -> "ops" [label="wraps", color="#58A978", style="dashed"];
  "suspendDecorator" -> "suspendOps" [label="wraps", color="#58A978", style="dashed"];
  "nativeBackends" -> "ops" [label="implements", color="#D9AA4D", style="solid"];
  "jcacheBackends" -> "suspendOps" [label="implements", color="#8A72D6", style="solid"];
  "resilienceConfig" -> "failure" [label="selects", color="#C85D55", style="solid"];
}
