digraph G {
  graph [rankdir=TB, bgcolor="white", splines=ortho, nodesep=0.55, ranksep=0.75];
  node [shape=box, style="rounded,filled", fontname="Architects Daughter", fontsize=18, color="#D7E2EC", fillcolor="#F7FAFC"];
  edge [fontname="Comic Mono", fontsize=11, color="#56708C", arrowsize=0.8];
  "service" [label="Repository/service code", shape=box, fillcolor="#E8F3FF", color="#75A9E8"];
  "projection" [label="Projection model", shape=box, fillcolor="#EAF7EF", color="#69B888"];
  "criteria" [label="Search criteria", shape=box, fillcolor="#FFF3D9", color="#D9AA4D"];
  "flow-api" [label="Flow collection extensions", shape=box, fillcolor="#E9F7F6", color="#45A7A1"];
  "collection-api" [label="MongoCollection helpers", shape=box, fillcolor="#F1ECFF", color="#8A72D6"];
  "dsl-builder" [label="Aggregation DSL", shape=box, fillcolor="#FCE7F3", color="#DB7890"];
  "pipeline" [label="Pipeline document list", shape=box, fillcolor="#FFF3D9", color="#D9AA4D"];
  "mapper" [label="Result mapper", shape=box, fillcolor="#EAF7EF", color="#69B888"];
  "driver-api" [label="MongoDB Java driver", shape=box, fillcolor="#E9F7F6", color="#45A7A1"];
  "server" [label="MongoDB server", shape=box, fillcolor="#F1ECFF", color="#8A72D6"];
  "service" -> "flow-api" [color="#4F83BF"];
  "projection" -> "collection-api" [color="#58A978"];
  "criteria" -> "collection-api" [color="#D9AA4D"];
  "flow-api" -> "dsl-builder" [color="#45A7A1"];
  "collection-api" -> "pipeline" [color="#8A72D6"];
  "dsl-builder" -> "pipeline" [color="#DB7890"];
  "pipeline" -> "mapper" [color="#D9AA4D"];
  "pipeline" -> "driver-api" [color="#D9AA4D"];
  "mapper" -> "driver-api" [color="#58A978"];
  "driver-api" -> "server" [color="#45A7A1"];
}
