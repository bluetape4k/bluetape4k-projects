digraph G {
  graph [rankdir=LR, splines=ortho, nodesep=0.7, ranksep=0.85, fontname="Comic Mono", label="Appointment Complex FSM"];
  node [shape=box, style="rounded,filled", fontname="Architects Daughter", fontsize=18, color="#D7E2EC", fillcolor="#F7FAFC"];
  edge [fontname="Comic Mono", fontsize=11, color="#56708C", arrowsize=0.8];
  "PENDING";
  "REQUESTED";
  "CONFIRMED";
  "CHECKED_IN";
  "IN_PROGRESS";
  "COMPLETED";
  "CANCELLED";
  "NO_SHOW";
  "PENDING" -> "REQUESTED" [label="Request"];
  "REQUESTED" -> "CONFIRMED" [label="Confirm"];
  "CONFIRMED" -> "CHECKED_IN" [label="CheckIn"];
  "CHECKED_IN" -> "IN_PROGRESS" [label="StartTreatment"];
  "IN_PROGRESS" -> "COMPLETED" [label="Complete"];
  "PENDING" -> "CANCELLED" [label="Cancel"];
  "REQUESTED" -> "CANCELLED" [label="Cancel"];
  "CONFIRMED" -> "CANCELLED" [label="Cancel"];
  "CHECKED_IN" -> "CANCELLED" [label="Cancel"];
  "CONFIRMED" -> "NO_SHOW" [label="MarkNoShow"];
}
