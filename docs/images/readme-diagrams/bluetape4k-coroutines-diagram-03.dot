digraph G {
  graph [rankdir=TB, bgcolor="white", splines=ortho, nodesep=0.55, ranksep=0.75];
  node [shape=box, style="rounded,filled", fontname="Architects Daughter", fontsize=18, color="#D7E2EC", fillcolor="#F7FAFC"];
  edge [fontname="Comic Mono", fontsize=11, color="#56708C", arrowsize=0.8];
  "package" [label="Flow extensions package", shape=box, fillcolor="#E8F3FF", color="#75A9E8"];
  "shape" [label="Shape the stream", shape=box, fillcolor="#EAF7EF", color="#69B888"];
  "parallel" [label="Run work concurrently", shape=box, fillcolor="#FFF3D9", color="#D9AA4D"];
  "combine" [label="Combine streams", shape=box, fillcolor="#E9F7F6", color="#45A7A1"];
  "state" [label="Stateful subjects", shape=box, fillcolor="#F1ECFF", color="#8A72D6"];
  "time" [label="Control timing", shape=box, fillcolor="#FCE7F3", color="#DB7890"];
  "context" [label="Bridge context", shape=box, fillcolor="#EEF6D9", color="#8BA84D"];
  "test" [label="Verify streams", shape=box, fillcolor="#F6F8FA", color="#AAB7C4"];
