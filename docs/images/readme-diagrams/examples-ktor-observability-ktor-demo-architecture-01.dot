digraph "examples-ktor-observability-ktor-demo-architecture-01" {
  graph [rankdir=TB, bgcolor="#F6F9FC", splines=ortho, nodesep=0.7, ranksep=1.0];
  node [shape=box, style="rounded,filled", color="#D7E2EC", fillcolor="#FFFFFF", fontname="Architects Daughter"];
  edge [color="#758297", arrowsize=0.8, fontname="Comic Mono"];
  subgraph cluster_entry {
    label="Entry layer";
    color="#D7E2EC";
    style="rounded";
    rank=same;
    client [label="HTTP Client", fillcolor="#E8F3FF", color="#5B8DEF"];
    routes [label="Ktor Routes", fillcolor="#E9F7F6", color="#45A7A1"];
  }
  subgraph cluster_platform {
    label="Ktor platform layer";
    color="#D7E2EC";
    style="rounded";
    rank=same;
    core [label="bluetape4k Ktor Core", fillcolor="#FFFFFF", color="#758297"];
    observability [label="Ktor Observability", fillcolor="#FFF3D9", color="#D6A441"];
  }
  subgraph cluster_application {
    label="Application event layer";
    color="#D7E2EC";
    style="rounded";
    rank=same;
    service [label="OrderEvent TelemetryService", fillcolor="#EAF7EF", color="#58A978"];
    eventObs [label="Event Telemetry", fillcolor="#EAF7EF", color="#58A978"];
  }
  subgraph cluster_export {
    label="Export layer";
    color="#D7E2EC";
    style="rounded";
    rank=same;
    registry [label="Prometheus MeterRegistry", fillcolor="#FFF3D9", color="#D6A441"];
    otel [label="OpenTelemetry SDK optional", fillcolor="#F1ECFF", color="#8A72D6"];
  }
  client -> routes [label="", color="#5B8DEF"];
  routes -> core [label="", color="#758297"];
  routes -> observability [label="", color="#D6A441"];
  routes -> service [label="", color="#58A978"];
  routes -> registry [label="", color="#D6A441"];
  observability -> registry [label="", color="#D6A441"];
  observability -> otel [label="", color="#8A72D6", style=dashed];
  service -> eventObs [label="", color="#58A978"];
  eventObs -> registry [label="", color="#58A978"];
}