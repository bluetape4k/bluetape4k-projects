{
  "env": {
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Skill(git-commit)",
      "Bash(omc update:*)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "Bash(curl:*)",
      "Bash(ls:*)",
      "Bash(./gradlew:*)",
      "Bash(cat:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(jar tf:*)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "jetbrainsMCP"
  ],
  "enabledPlugins": {
    "oh-my-claudecode@omc": true,
    "code-review-graph@code-review-graph": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/kt-test-compile.sh",
            "asyncRewake": true,
            "timeout": 120,
            "statusMessage": "Kotlin 테스트 컴파일 검증 중..."
          }
        ]
      }
    ]
  }
}
